set func_door worldtype=0 noise4 door/unlock_old
set func_door worldtype=1 noise3 door/locked_rune
set func_door worldtype=1 noise4 door/unlock_rune
set func_door worldtype=2 noise3 door/locked_base
set func_door worldtype=2 noise4 door/unlock_base

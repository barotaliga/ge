set func_door sounds=0 noise1 common/silence
set func_door sounds=0 noise2 common/silence
set func_door sounds=1 noise1 door/stone_stop
set func_door sounds=1 noise2 door/stone_move
set func_door sounds=2 noise1 door/machine_stop
set func_door sounds=2 noise2 door/machine_move

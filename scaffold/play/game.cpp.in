// THE GAME ON THE PLAY CONTRACT: what an agent plays through `ge play` and the pilot plays
// through `ge sim`. The spec names the axes (the whole input: here the steer), the options a run
// is opened with, and the Run wraps the simulation: one step on the snapped axes, what a player
// sees, everything that decides the next step, the report, the game's own pilot and the views
// `ge shot` draws. Grow it with the game: a new input is an axis, a new setting an option, a new
// picture a view (skill: play-test).
//
// ge:summary The game on the play contract: its axes, options, observe, state, report and pilot
// ge:keywords play contract game spec run axes options observe state report pilot ge_game shoot
// ge:skill play-test
// ge:test tests/sim_game_test.cpp
#include <array>
#include <memory>
#include <span>
#include <string>
#include <string_view>

#include "core/math.hpp"
#include "core/num.hpp"
#include "core/num_text.hpp"
#include "lab/raster.hpp"
#include "play/game.hpp"
#include "sim/game.hpp"

namespace {

namespace num = ge::core::num;
namespace sim = {{ident}}::sim;

class Run final : public ge::play::Run {
 public:
  explicit Run(uint32_t seed) : state_(sim::create_game(seed)) {}

  void step(std::span<const double> input) override { sim::step(state_, sim::Input{input[0]}); }
  bool over() const override { return false; }  // the demo runs to the spec's longest run
  uint64_t digest() const override { return sim::digest(state_); }
  std::string observe() override {
    return "{\"x\":" + num::to_fixed(state_.x_m, 3) + ",\"vx\":" + num::to_fixed(state_.vx_mps, 3) +
           "}";
  }
  std::string state() const override {
    return "{\"steps\":" + std::to_string(state_.steps) +
           ",\"rng\":" + std::to_string(state_.rng.a) + ",\"x_m\":" + num::to_string(state_.x_m) +
           ",\"vx_mps\":" + num::to_string(state_.vx_mps) + "}";
  }
  std::string report() const override { return "{\"x\":" + num::to_fixed(state_.x_m, 3) + "}"; }
  // The pilot steers the body back to the middle.
  bool pilot(std::span<double> input) override {
    input[0] = ge::core::clamp(-(state_.x_m + state_.vx_mps), -1, 1);
    return true;
  }
  // `ge shot`'s one view: the field from above, 10 m either side of the middle, the body on it.
  bool shoot(std::string_view view, ge::lab::Picture& out, std::string& caption,
             std::string& error) override {
    if (view != "field") {
      error = "no view `" + std::string(view) + "`";
      return false;
    }
    constexpr int kW = 480, kH = 96;
    constexpr double kPxPerM = kW / 20.0;
    out = ge::lab::create_picture(kW, kH, {226, 232, 238});
    ge::lab::draw_line(out, kW / 2.0, 0, kW / 2.0, kH, {150, 160, 170});
    const double x = kW / 2.0 + state_.x_m * kPxPerM;
    ge::lab::fill_disc(out, x, kH / 2.0, 8, {200, 40, 40});
    caption = "The demo body " + num::to_fixed(state_.x_m, 2) +
              " m from the middle (the grey line), moving at " + num::to_fixed(state_.vx_mps, 2) +
              " m/s.";
    return true;
  }

 private:
  sim::GameState state_;
};

std::unique_ptr<ge::play::Run> open(const ge::play::Setup& setup, std::string& error) {
  if (setup.seed < 0 || setup.seed != num::round(setup.seed)) {
    error = "the seed must be a whole number, 0 or more";
    return nullptr;
  }
  return std::make_unique<Run>(static_cast<uint32_t>(setup.seed));
}

constexpr std::array<ge::play::View, 1> kViews{{
    {"field", "the field from above, 10 m either side of the middle, the body on it"},
}};

constexpr std::array<ge::play::Axis, 1> kAxes{{
    {"steer", ge::play::AxisKind::signed_unit, "-1 left .. 1 right"},
}};

const ge::play::GameSpec kGame{
    .name = "{{ident}}",
    .summary = "the demo body pushed by the steer and a seeded gust",
    .hz = sim::kStepHz,
    .most_seconds = 30,
    .axes = kAxes,
    .options = {},
    .open = open,
    .views = kViews,
};

}  // namespace

GE_GAME(kGame);

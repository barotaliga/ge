# Every push and pull request: `ge check` (the format, the agent guidance and the rules, the build
# and every test and lab), with the sanitizers and without. The pinned release's ge is built first.
name: ci

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    name: check (${{ matrix.preset }})
    runs-on: ubuntu-24.04
    strategy:
      fail-fast: false
      matrix:
        preset: [debug, release]
    steps:
      - uses: actions/checkout@v5
      - run: sudo apt-get update && sudo apt-get install -y --no-install-recommends ninja-build clang-format
      - run: make ge-build PRESET=${{ matrix.preset }}
      - run: build/${{ matrix.preset }}/ge check --preset=${{ matrix.preset }}

// The definitions behind game.hpp: the demo body pushed by the input and a seeded gust each
// step, held back by a drag. Replace it with the game; keep its shape (skill: sim-system).
//
// ge:summary The step's definition: input and a seeded gust move the demo body; the state's digest
// ge:keywords sim step gust drag digest fnv
// ge:skill sim-system
// ge:test tests/sim_game_test.cpp
#include "sim/game.hpp"

#include <cstring>

namespace {{ident}}::sim {

namespace {

constexpr double kPush = 4.0;  // m/s² at full steer
constexpr double kDrag = 0.5;  // 1/s

void mix(uint64_t& h, const void* bytes, size_t n) {
  const auto* p = static_cast<const unsigned char*>(bytes);
  for (size_t i = 0; i < n; i++) {
    h ^= p[i];
    h *= 0x100000001b3ull;
  }
}

}  // namespace

GameState create_game(uint32_t seed) {
  GameState s;
  s.seed = seed;
  s.rng = ge::core::make_rng(seed);
  return s;
}

void step(GameState& s, const Input& input) {
  const double gust = ge::core::range(s.rng, -1.0, 1.0);
  s.vx_mps += (input.steer * kPush + gust - s.vx_mps * kDrag) * kDt;
  s.x_m += s.vx_mps * kDt;
  s.steps++;
}

uint64_t digest(const GameState& s) {
  uint64_t h = 0xcbf29ce484222325ull;
  mix(h, &s.seed, sizeof s.seed);
  mix(h, &s.steps, sizeof s.steps);
  mix(h, &s.rng.a, sizeof s.rng.a);
  mix(h, &s.x_m, sizeof s.x_m);
  mix(h, &s.vx_mps, sizeof s.vx_mps);
  return h;
}

}  // namespace {{ident}}::sim

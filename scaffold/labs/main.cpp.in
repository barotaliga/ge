// The `labs` executable's entry point: every labs/*.cpp is compiled into the same binary and
// registers itself with GE_LAB, so this is one call to the engine's lab runner (skill: labs).
//
// ge:summary The labs executable's main: hands the command line to the engine's lab runner
// ge:keywords lab labs main executable runner
// ge:skill labs
#include "lab/runner.hpp"

int main(int argc, char** argv) { return ge::lab::run_labs(argc, argv); }

# MODS AS BUILT (docs/mods.md, skill: mod): `ge_add_mod` makes a mod's shared library and, after
# every build, its package manifest beside it, so the output directory IS a package the game
# loads (engine/mod/loader.hpp). Used by this tree (the sample mod, the tests' fixtures) and by a
# mod repo that `ge mod new` writes, which includes this file from the engine tree it builds
# against. A mod links nothing of the engine: it compiles against engine/mod/abi.hpp and its
# game's header only, with the engine's determinism flags (cmake/Fp.cmake).
#
#   ge_add_mod(<target> NAME <kebab> VERSION <x.y.z> GAME <id> GAME_API <N|N..M>
#              SOURCES <files...> [INCLUDE_DIRS <dirs...>] [OUTPUT_DIR <dir>] [WASM])
#
# The library is <NAME with '-' as '_'>.so (.dll on Windows) in OUTPUT_DIR (default
# ${CMAKE_BINARY_DIR}/mods/<NAME>), with `mod.manifest` listing it for this platform with its
# SHA-256. The platform's name here must be engine/mod/manifest.cpp's `this_platform`: the sample
# mod's test loads what this file writes, so the two cannot drift apart unseen.
#
# WASM: the same sources also built for wasm32 (the store form, docs/mods.md § The store form),
# as <NAME with '-' as '_'>.wasm beside the library, by clang and wasm-ld with no C or C++ library
# (a mod needs none: abi.hpp's headers are the compiler's own). Only where both are found
# (GE_MOD_WASM_CLANG, GE_MOD_WASM_LD) and the compiler has the target (GE_MOD_WASM_WORKS);
# elsewhere nothing is built and the tests that run it skip. The manifest then lists it as
# `file.wasm32`, so the package carries both forms. GE_MOD_BUILD_WASM=ON (what `ge mod build
# --wasm` passes) builds every mod's module, and stops the configure when there is no toolchain.
#
#   ge_link_mods(<app target> <mod targets...>)
#
# AHEAD-OF-TIME LINKING (engine/mod/linked.hpp): each mod's sources compiled natively into the
# app, its entry renamed `ge_mod_entry_<NAME with '-' as '_'>`, and registered under the SHA-256
# of its wasm32 module, so a store build that loads only that row runs the mod at native speed.
# The module must be built (WASM on the mod, and the toolchain): with none, nothing is linked,
# the app interprets the module, and the configure says so. A mod linked so keeps its state in its
# own `State` like any other, but its sources share the app's link: every name a mod's sources
# define outside an anonymous namespace (other than the entry) must be unique across the mods
# one app links.
#
# Run as a script (-P), this file writes that manifest: -DLIB -DOUT -DNAME -DVERSION -DGAME
# -DGAME_API -DABI -DPLATFORM, and -DWASM (the module, listed when it is there). With -DLINK_OUT
# it writes a linked mod's registration instead: -DWASM -DNAME -DENTRY.
if(CMAKE_SCRIPT_MODE_FILE AND LINK_OUT)
  file(SHA256 "${WASM}" hash)
  string(CONCAT text "// Generated by cmake/Mods.cmake (ge_link_mods): ${NAME} linked into the app.\n"
    "#include \"mod/linked.hpp\"\n"
    "extern \"C\" const ge_mod_v1* ${ENTRY}(uint32_t host_abi);\n"
    "namespace {\n"
    "[[maybe_unused]] const bool kLinked = ge::mod::link_mod({\"${NAME}\", \"${hash}\", &${ENTRY}});\n"
    "}  // namespace\n")
  file(WRITE "${LINK_OUT}" "${text}")
  return()
endif()
if(CMAKE_SCRIPT_MODE_FILE)
  file(SHA256 "${LIB}" hash)
  get_filename_component(file "${LIB}" NAME)
  set(wasm_row "")
  if(WASM AND EXISTS "${WASM}")
    file(SHA256 "${WASM}" wasm_hash)
    get_filename_component(wasm_file "${WASM}" NAME)
    set(wasm_row "file.wasm32 = ${wasm_file} ${wasm_hash}\n")
  endif()
  file(WRITE "${OUT}"
    "# A mod package (docs/mods.md § The package). Written by the build (cmake/Mods.cmake).\n"
    "name = ${NAME}\nversion = ${VERSION}\ngame = ${GAME}\ngame_api = ${GAME_API}\n"
    "abi = ${ABI}\nfile.${PLATFORM} = ${file} ${hash}\n${wasm_row}")
  return()
endif()

include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Fp.cmake")
find_program(GE_MOD_WASM_CLANG NAMES clang++ clang++-18 clang++-19 clang++-20)
find_program(GE_MOD_WASM_LD NAMES wasm-ld wasm-ld-18 wasm-ld-19 wasm-ld-20)
# A clang that has no wasm32 target (Apple's) is no toolchain: probed once, with a module of one
# exported function.
if(GE_MOD_WASM_CLANG AND GE_MOD_WASM_LD AND NOT DEFINED GE_MOD_WASM_WORKS)
  set(probe "${CMAKE_BINARY_DIR}/CMakeFiles/ge_mod_wasm_probe")
  file(WRITE "${probe}.cpp" "extern \"C\" __attribute__((visibility(\"default\"))) int f(int x) { return x; }\n")
  get_filename_component(ld_dir "${GE_MOD_WASM_LD}" DIRECTORY)
  execute_process(COMMAND "${GE_MOD_WASM_CLANG}" --target=wasm32 -O2 -nostdlib "-B${ld_dir}"
      -Wl,--no-entry -Wl,--export=f -o "${probe}.wasm" "${probe}.cpp"
    RESULT_VARIABLE probe_result OUTPUT_QUIET ERROR_QUIET)
  if(probe_result EQUAL 0)
    set(GE_MOD_WASM_WORKS ON CACHE INTERNAL "clang builds wasm32 modules")
  else()
    set(GE_MOD_WASM_WORKS OFF CACHE INTERNAL "clang builds wasm32 modules")
  endif()
endif()
option(GE_MOD_BUILD_WASM "Build every mod's wasm32 module too (ge mod build --wasm)" OFF)
if(GE_MOD_BUILD_WASM AND NOT GE_MOD_WASM_WORKS)
  message(FATAL_ERROR "GE_MOD_BUILD_WASM: no clang with the wasm32 target and wasm-ld was found; "
    "next: install clang and lld (sudo apt install clang lld; brew install llvm lld), or set "
    "GE_MOD_WASM_CLANG and GE_MOD_WASM_LD to them")
endif()
function(ge_add_mod target)
  cmake_parse_arguments(M "WASM" "NAME;VERSION;GAME;GAME_API;OUTPUT_DIR" "SOURCES;INCLUDE_DIRS" ${ARGN})
  foreach(key NAME VERSION GAME GAME_API SOURCES)
    if(NOT M_${key})
      message(FATAL_ERROR "ge_add_mod(${target}): no ${key}; next: pass it (cmake/Mods.cmake "
        "lists the arguments)")
    endif()
  endforeach()
  # The engine tree, the ABI and the platform, worked out here (an include guard keeps a
  # directory-scope variable from reaching a second directory).
  get_filename_component(engine "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  # The ABI a mod built here speaks, read off engine/mod/abi.hpp (stated there once).
  file(STRINGS "${engine}/engine/mod/abi.hpp" abi REGEX "^#define GE_MOD_ABI_(MAJOR|MINOR) [0-9]+$")
  string(REGEX REPLACE ".*GE_MOD_ABI_MAJOR ([0-9]+).*" "\\1" abi_major "${abi}")
  string(REGEX REPLACE ".*GE_MOD_ABI_MINOR ([0-9]+).*" "\\1" abi_minor "${abi}")
  # This build's platform in the manifest's words: linux|macos|windows - x64|arm64.
  if(WIN32)
    set(os windows)
  elseif(APPLE)
    set(os macos)
  else()
    set(os linux)
  endif()
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    set(arch x64)
  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    set(arch arm64)
  else()
    set(arch "${CMAKE_SYSTEM_PROCESSOR}")
  endif()
  if(NOT M_OUTPUT_DIR)
    set(M_OUTPUT_DIR "${CMAKE_BINARY_DIR}/mods/${M_NAME}")
  endif()
  string(REPLACE "-" "_" lib_name "${M_NAME}")
  add_library(${target} MODULE ${M_SOURCES})
  # A generator expression keeps a multi-config generator from adding a per-config directory.
  set_target_properties(${target} PROPERTIES PREFIX "" OUTPUT_NAME "${lib_name}"
    LIBRARY_OUTPUT_DIRECTORY "$<1:${M_OUTPUT_DIR}>" RUNTIME_OUTPUT_DIRECTORY "$<1:${M_OUTPUT_DIR}>"
    CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
  if(APPLE)
    set_target_properties(${target} PROPERTIES SUFFIX ".so")
  endif()
  target_compile_features(${target} PRIVATE cxx_std_20)
  target_include_directories(${target} PRIVATE "${engine}/engine" ${M_INCLUDE_DIRS})
  target_link_libraries(${target} PRIVATE ge_fp ge_isa)
  if(TARGET ge_flags)
    target_link_libraries(${target} PRIVATE ge_flags)
  endif()
  set(wasm "${M_OUTPUT_DIR}/${lib_name}.wasm")
  set(write_manifest ${CMAKE_COMMAND} "-DLIB=$<TARGET_FILE:${target}>"
    "-DOUT=${M_OUTPUT_DIR}/mod.manifest" "-DNAME=${M_NAME}" "-DVERSION=${M_VERSION}"
    "-DGAME=${M_GAME}" "-DGAME_API=${M_GAME_API}" "-DABI=${abi_major}.${abi_minor}"
    "-DPLATFORM=${os}-${arch}" "-DWASM=${wasm}" -P "${engine}/cmake/Mods.cmake")
  add_custom_command(TARGET ${target} POST_BUILD COMMAND ${write_manifest} VERBATIM)
  set_property(GLOBAL APPEND PROPERTY GE_MOD_TARGETS ${target})
  set(dirs "")  # absolute: the wasm32 command runs in the build directory, ge_link_mods elsewhere
  set(includes "-I${engine}/engine")
  foreach(dir ${M_INCLUDE_DIRS})
    get_filename_component(dir "${dir}" ABSOLUTE)
    list(APPEND dirs "${dir}")
    list(APPEND includes "-I${dir}")
  endforeach()
  set(sources "")
  foreach(src ${M_SOURCES})
    get_filename_component(src "${src}" ABSOLUTE)
    list(APPEND sources "${src}")
  endforeach()
  set_target_properties(${target} PROPERTIES GE_MOD_NAME "${M_NAME}" GE_MOD_SOURCES "${sources}"
    GE_MOD_INCLUDE_DIRS "${dirs}" GE_MOD_ENGINE "${engine}")
  if((M_WASM OR GE_MOD_BUILD_WASM) AND GE_MOD_WASM_WORKS)
    set_target_properties(${target} PROPERTIES GE_MOD_WASM "${wasm}")
    get_filename_component(ld_dir "${GE_MOD_WASM_LD}" DIRECTORY)
    add_custom_command(OUTPUT "${wasm}"
      COMMAND "${GE_MOD_WASM_CLANG}" --target=wasm32 -std=c++20 -O2 -ffp-contract=off -nostdlib
        -fno-exceptions -fno-rtti -fvisibility=hidden ${includes} "-B${ld_dir}"
        -Wl,--no-entry -Wl,--export=ge_mod_entry -Wl,--export-table -Wl,--growable-table
        -o "${wasm}" ${sources}
      COMMAND ${write_manifest}
      DEPENDS ${target} ${sources} "${engine}/engine/mod/abi.hpp"
      COMMENT "Building the mod ${M_NAME} for wasm32"
      VERBATIM)
    add_custom_target(${target}_wasm ALL DEPENDS "${wasm}")
    add_dependencies(${target}_wasm ${target})  # the package directory first
    set_property(GLOBAL APPEND PROPERTY GE_MOD_TARGETS ${target}_wasm)
  endif()
endfunction()

function(ge_link_mods app)
  foreach(mod ${ARGN})
    get_target_property(name ${mod} GE_MOD_NAME)
    get_target_property(wasm ${mod} GE_MOD_WASM)
    if(NOT name)
      message(FATAL_ERROR "ge_link_mods(${app}): ${mod} is not a mod; next: pass targets made by "
        "ge_add_mod")
    endif()
    if(NOT wasm)
      message(STATUS "ge_link_mods(${app}): ${name} has no wasm32 module here (no WASM, or no "
        "clang with the wasm32 target), so ${app} interprets it; next: add WASM to its ge_add_mod "
        "and install clang and wasm-ld")
      continue()
    endif()
    get_target_property(sources ${mod} GE_MOD_SOURCES)
    get_target_property(dirs ${mod} GE_MOD_INCLUDE_DIRS)
    get_target_property(engine ${mod} GE_MOD_ENGINE)
    string(REPLACE "-" "_" cname "${name}")
    set(entry "ge_mod_entry_${cname}")
    set(objects ${app}_linked_${cname})
    add_library(${objects} OBJECT ${sources})
    target_compile_features(${objects} PRIVATE cxx_std_20)
    target_compile_definitions(${objects} PRIVATE "ge_mod_entry=${entry}")
    target_include_directories(${objects} PRIVATE "${engine}/engine" ${dirs})
    target_link_libraries(${objects} PRIVATE ge_fp ge_isa)
    if(TARGET ge_flags)
      target_link_libraries(${objects} PRIVATE ge_flags)
    endif()
    set(registration "${CMAKE_CURRENT_BINARY_DIR}/${app}_linked_${cname}.cpp")
    add_custom_command(OUTPUT "${registration}"
      COMMAND ${CMAKE_COMMAND} "-DLINK_OUT=${registration}" "-DWASM=${wasm}" "-DNAME=${name}"
        "-DENTRY=${entry}" -P "${engine}/cmake/Mods.cmake"
      DEPENDS "${wasm}" ${mod}_wasm "${engine}/cmake/Mods.cmake"
      COMMENT "Linking the mod ${name} into ${app}"
      VERBATIM)
    target_sources(${app} PRIVATE "${registration}" $<TARGET_OBJECTS:${objects}>)
  endforeach()
endfunction()

# The script half of ge_embed_wgsl (cmake/Wgsl.cmake), run as `cmake -P` at build time:
# resolve IN's #include lines, drop its comment and blank lines, the indents and the comments after
# code, write RESOLVED, and write HEADER with the text as a string_view.
# Inputs: IN, HEADER, RESOLVED, NAME, ROOTS ('|'-separated include roots).
cmake_minimum_required(VERSION 3.25)
string(REPLACE "|" ";" roots "${ROOTS}")
set(seen "")

function(resolve file out_var)
  if(file IN_LIST seen)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  list(APPEND seen "${file}")
  set(seen "${seen}" PARENT_SCOPE)
  # Lines as a list: WGSL's ';' would split a CMake list, and an unbalanced '[' (a comment's
  # "[0, 1)") would open a bracket that swallows every line after it, so all three travel as
  # placeholders.
  file(READ "${file}" raw)
  string(REPLACE ";" "@SEMI@" raw "${raw}")
  string(REPLACE "[" "@LBRK@" raw "${raw}")
  string(REPLACE "]" "@RBRK@" raw "${raw}")
  string(REPLACE "\n" ";" lines "${raw}")
  get_filename_component(here "${file}" DIRECTORY)
  set(text "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^[ \t]*#include[ \t]+\"([^\"]+)\"")
      set(want "${CMAKE_MATCH_1}")
      set(found "")
      foreach(root IN ITEMS "${here}" ${roots})
        if(NOT found AND EXISTS "${root}/${want}")
          get_filename_component(found "${root}/${want}" ABSOLUTE)
        endif()
      endforeach()
      if(NOT found)
        message(FATAL_ERROR "wgsl: ${file}: #include \"${want}\" not found beside it or under "
          "${roots}. Fix the path; skill: gpu, § Shaders.")
      endif()
      resolve("${found}" inner)
      set(seen "${seen}" PARENT_SCOPE)
      string(APPEND text "${inner}")
    elseif(line MATCHES "^[ \t]*//")
      # A comment line is the reader's, not the GPU's: left out of what is embedded, so a shader
      # with its includes stays under the literal's cap however well it is explained.
    elseif(line MATCHES "^[ \t]*$")
      # A blank line: nothing to the GPU.
    else()
      # The indent and a comment after the code are the reader's too (WGSL has no strings, so a
      # '//' is always a comment).
      string(REGEX REPLACE "^[ \t]+" "" line "${line}")
      string(REGEX REPLACE "[ \t]*//.*$" "" line "${line}")
      string(REPLACE "@SEMI@" ";" line "${line}")
      string(REPLACE "@LBRK@" "[" line "${line}")
      string(REPLACE "@RBRK@" "]" line "${line}")
      string(APPEND text "${line}\n")
    endif()
  endforeach()
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

resolve("${IN}" wgsl)
file(WRITE "${RESOLVED}" "${wgsl}")

if(wgsl MATCHES "\\)wgsl\"")
  message(FATAL_ERROR "wgsl: ${IN} contains ')wgsl\"', the embedding's raw-string delimiter. "
    "Reword that text; skill: gpu, § Shaders.")
endif()
string(LENGTH "${wgsl}" size)
if(size GREATER 1000000)
  message(FATAL_ERROR "wgsl: ${IN} resolves to ${size} bytes, past the 1 MB a shader may embed. "
    "Split the pass's shader; skill: gpu, § Shaders.")
endif()
# Adjacent raw-string pieces of at most ~4 KB each (MSVC caps one piece at 16 KB), gathered into
# literals of at most 60 000 bytes (MSVC caps one literal, its pieces joined, at 64 KB). A shader
# that fits one literal is a constexpr string_view; a longer one is its literals joined once at
# start-up into a string the string_view looks at.
# A literal kept in the list travels with its ';', '[' and ']' as placeholders, as the lines do.
macro(ge_wgsl_keep_literal)
  string(REPLACE ";" "@SEMI@" kept "${body}")
  string(REPLACE "[" "@LBRK@" kept "${kept}")
  string(REPLACE "]" "@RBRK@" kept "${kept}")
  list(APPEND literals "${kept}")
endmacro()
set(literals "")
set(body "")
set(body_size 0)
set(piece "")
string(REPLACE ";" "@SEMI@" wgsl_list "${wgsl}")
string(REPLACE "[" "@LBRK@" wgsl_list "${wgsl_list}")
string(REPLACE "]" "@RBRK@" wgsl_list "${wgsl_list}")
string(REPLACE "\n" ";" wgsl_list "${wgsl_list}")
foreach(line IN LISTS wgsl_list)
  string(REPLACE "@SEMI@" ";" line "${line}")
  string(REPLACE "@LBRK@" "[" line "${line}")
  string(REPLACE "@RBRK@" "]" line "${line}")
  string(APPEND piece "${line}\n")
  string(LENGTH "${piece}" n)
  if(n GREATER 4000)
    math(EXPR grown "${body_size} + ${n}")
    if(grown GREATER 60000)
      ge_wgsl_keep_literal()
      set(body "")
      set(body_size 0)
    endif()
    string(APPEND body "    R\"wgsl(${piece})wgsl\"\n")
    math(EXPR body_size "${body_size} + ${n}")
    set(piece "")
  endif()
endforeach()
if(NOT piece STREQUAL "")
  string(LENGTH "${piece}" n)
  math(EXPR grown "${body_size} + ${n}")
  if(grown GREATER 60000)
    ge_wgsl_keep_literal()
    set(body "")
  endif()
  string(APPEND body "    R\"wgsl(${piece})wgsl\"\n")
endif()
ge_wgsl_keep_literal()
list(LENGTH literals count)
set(head "// GENERATED by cmake/WgslEmbed.cmake from ${IN}; do not edit.\n#pragma once\n\n")
if(count EQUAL 1)
  string(CONCAT text "${head}#include <string_view>\n\nnamespace ge::wgsl {\n\n"
    "inline constexpr std::string_view ${NAME} =\n${body};\n\n}  // namespace ge::wgsl\n")
else()
  set(joined "")
  foreach(literal IN LISTS literals)
    string(REPLACE "@SEMI@" ";" literal "${literal}")
    string(REPLACE "@LBRK@" "[" literal "${literal}")
    string(REPLACE "@RBRK@" "]" literal "${literal}")
    if(NOT joined STREQUAL "")
      string(APPEND joined " +\n")
    endif()
    string(APPEND joined "    std::string(\n${literal}    )")
  endforeach()
  string(CONCAT text "${head}#include <string>\n#include <string_view>\n\nnamespace ge::wgsl {\n\n"
    "inline const std::string ${NAME}_text =\n${joined};\n"
    "inline const std::string_view ${NAME} = ${NAME}_text;\n\n}  // namespace ge::wgsl\n")
endif()
file(WRITE "${HEADER}.tmp" "${text}")
file(COPY_FILE "${HEADER}.tmp" "${HEADER}" ONLY_IF_DIFFERENT)
file(REMOVE "${HEADER}.tmp")

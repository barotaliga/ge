# The script half of ge_embed_wgsl (cmake/Wgsl.cmake), run as `cmake -P` at build time:
# resolve IN's #include lines, drop its comment lines, write RESOLVED, and write HEADER with the
# text as a string_view.
# Inputs: IN, HEADER, RESOLVED, NAME, ROOTS ('|'-separated include roots).
cmake_minimum_required(VERSION 3.25)
string(REPLACE "|" ";" roots "${ROOTS}")
set(seen "")

function(resolve file out_var)
  if(file IN_LIST seen)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  list(APPEND seen "${file}")
  set(seen "${seen}" PARENT_SCOPE)
  # Lines as a list: WGSL's ';' would split a CMake list, so it travels as a placeholder.
  file(READ "${file}" raw)
  string(REPLACE ";" "@SEMI@" raw "${raw}")
  string(REPLACE "\n" ";" lines "${raw}")
  get_filename_component(here "${file}" DIRECTORY)
  set(text "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^[ \t]*#include[ \t]+\"([^\"]+)\"")
      set(want "${CMAKE_MATCH_1}")
      set(found "")
      foreach(root IN ITEMS "${here}" ${roots})
        if(NOT found AND EXISTS "${root}/${want}")
          get_filename_component(found "${root}/${want}" ABSOLUTE)
        endif()
      endforeach()
      if(NOT found)
        message(FATAL_ERROR "wgsl: ${file}: #include \"${want}\" not found beside it or under "
          "${roots}. Fix the path; skill: gpu, § Shaders.")
      endif()
      resolve("${found}" inner)
      set(seen "${seen}" PARENT_SCOPE)
      string(APPEND text "${inner}")
    elseif(line MATCHES "^[ \t]*//")
      # A comment line is the reader's, not the GPU's: left out of what is embedded, so a shader
      # with its includes stays under the literal's cap however well it is explained.
    else()
      string(REPLACE "@SEMI@" ";" line "${line}")
      string(APPEND text "${line}\n")
    endif()
  endforeach()
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

resolve("${IN}" wgsl)
file(WRITE "${RESOLVED}" "${wgsl}")

if(wgsl MATCHES "\\)wgsl\"")
  message(FATAL_ERROR "wgsl: ${IN} contains ')wgsl\"', the embedding's raw-string delimiter. "
    "Reword that text; skill: gpu, § Shaders.")
endif()
string(LENGTH "${wgsl}" size)
if(size GREATER 60000)
  message(FATAL_ERROR "wgsl: ${IN} resolves to ${size} bytes; one string literal must stay "
    "under 64 KB (MSVC). Split the pass's shader; skill: gpu, § Shaders.")
endif()
# Adjacent raw-string pieces of at most ~4 KB each (MSVC caps one piece at 16 KB).
set(body "")
set(piece "")
string(REPLACE ";" "@SEMI@" wgsl_list "${wgsl}")
string(REPLACE "\n" ";" wgsl_list "${wgsl_list}")
foreach(line IN LISTS wgsl_list)
  string(REPLACE "@SEMI@" ";" line "${line}")
  string(APPEND piece "${line}\n")
  string(LENGTH "${piece}" n)
  if(n GREATER 4000)
    string(APPEND body "    R\"wgsl(${piece})wgsl\"\n")
    set(piece "")
  endif()
endforeach()
if(NOT piece STREQUAL "")
  string(APPEND body "    R\"wgsl(${piece})wgsl\"\n")
endif()
file(WRITE "${HEADER}.tmp" "// GENERATED by cmake/WgslEmbed.cmake from ${IN}; do not edit.\n"
  "#pragma once\n\n#include <string_view>\n\nnamespace ge::wgsl {\n\n"
  "inline constexpr std::string_view ${NAME} =\n${body};\n\n}  // namespace ge::wgsl\n")
file(COPY_FILE "${HEADER}.tmp" "${HEADER}" ONLY_IF_DIFFERENT)
file(REMOVE "${HEADER}.tmp")

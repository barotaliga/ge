# The script half of ge_source_stamp (cmake/SourceStamp.cmake), run as `cmake -P` at build time:
# OUT holds NAME, the SHA-256 over every file LIST names (its path under ROOT, then its bytes'
# own SHA-256). Inputs: LIST, OUT, NAME, ROOT.
cmake_minimum_required(VERSION 3.25)

file(STRINGS "${LIST}" files)
set(all "")
foreach(file IN LISTS files)
  file(SHA256 "${file}" sum)
  file(RELATIVE_PATH rel "${ROOT}" "${file}")
  string(APPEND all "${rel} ${sum}\n")
endforeach()
string(SHA256 stamp "${all}")
file(WRITE "${OUT}.tmp" "// GENERATED by cmake/SourceStamp.cmake: the stamp of the code a content cache keys on.
#pragma once
inline constexpr const char ${NAME}[] = \"${stamp}\";
")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)

# A file compiled into a target as bytes: `ge_embed_binary(<target> <symbol> <file>)` writes, at
# build time, a C++ file defining
#
#   extern const unsigned char <symbol>[];    // the file's bytes, as they are on disk
#   extern const std::size_t <symbol>_size;
#
# and adds it to <target>, which declares the two itself where it reads them. A game ships the
# models it draws this way (a committed .glb: `ge asset`), so it reads nothing from disk at run
# time and runs from any directory on every platform. The bytes are copied as they are: a model is
# binary, so nothing is dropped or translated (cmake/EmbedFiles.cmake, for text, drops '\r').
#
# Run as `cmake -P` (the script half), it writes OUT from IN for SYMBOL.
cmake_minimum_required(VERSION 3.25)

if(CMAKE_SCRIPT_MODE_FILE)
  file(READ "${IN}" hex HEX)
  string(LENGTH "${hex}" chars)
  math(EXPR size "${chars} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  # 32 bytes a line keeps the generated file readable in a debugger.
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n    " bytes "${bytes}")
  file(WRITE "${OUT}.tmp"
    "// GENERATED by cmake/EmbedBinary.cmake from ${NAME}; never edit.\n"
    "#include <cstddef>\n"
    "extern const unsigned char ${SYMBOL}[];\n"
    "extern const std::size_t ${SYMBOL}_size;\n"
    "const unsigned char ${SYMBOL}[] = {\n    ${bytes}0};\n"
    "const std::size_t ${SYMBOL}_size = ${size};\n")
  file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
  file(REMOVE "${OUT}.tmp")
  return()
endif()

include_guard(GLOBAL)
set(GE_EMBED_BINARY_SCRIPT "${CMAKE_CURRENT_LIST_FILE}")

function(ge_embed_binary target symbol file)
  get_filename_component(abs "${file}" ABSOLUTE)
  if(NOT EXISTS "${abs}")
    message(FATAL_ERROR "ge_embed_binary(${target} ${symbol}): ${abs} does not exist. Build it "
      "(a model: `ge asset build <name>`) or fix the path; skill: assets.")
  endif()
  file(RELATIVE_PATH rel "${PROJECT_SOURCE_DIR}" "${abs}")
  set(gen "${PROJECT_BINARY_DIR}/gen/embed/${symbol}.cpp")
  add_custom_command(OUTPUT "${gen}"
    COMMAND ${CMAKE_COMMAND} -DIN=${abs} -DOUT=${gen} -DSYMBOL=${symbol} -DNAME=${rel}
            -P "${GE_EMBED_BINARY_SCRIPT}"
    DEPENDS "${abs}" "${GE_EMBED_BINARY_SCRIPT}"
    COMMENT "ge: embedding ${rel}"
    VERBATIM)
  target_sources(${target} PRIVATE "${gen}")
endfunction()

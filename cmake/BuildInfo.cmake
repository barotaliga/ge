# THE BUILD'S OWN STAMP (engine/capture/build_info.hpp): which source a binary was built from, for a
# report a player or an agent pastes (`gpudebug`'s notes): the commit, whether the tree had changes
# not committed (how many files, and a hash of the diff, so two builds of one dirty tree tell apart),
# the branch, the commit's date, the build type, the compiler and the system.
#
# `ge_build_info` is a small library of one generated file, written on every build by the script
# half below and replaced only when what it says has changed, so an unchanged tree rebuilds nothing
# and a new commit relinks only what links it: a game's window, never the whole tree. A tree with no
# git (a source tarball) says "unknown".
#
# Run as `cmake -P` (the script half), it writes OUT from the git checkout at ROOT.
cmake_minimum_required(VERSION 3.25)

if(CMAKE_SCRIPT_MODE_FILE)
  set(commit "unknown")
  set(branch "unknown")
  set(date "unknown")
  set(dirty_files 0)
  set(dirty_hash "")
  find_package(Git QUIET)
  if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" rev-parse --short=12 HEAD
                    OUTPUT_VARIABLE got RESULT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET)
    if(status EQUAL 0 AND got)
      set(commit "${got}")
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" rev-parse --abbrev-ref HEAD
                      OUTPUT_VARIABLE branch OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" log -1 --format=%cI
                      OUTPUT_VARIABLE date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      # The tracked files changed since the commit (new files not counted: a build ignores them
      # until they are added to it), and a hash of that diff.
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" diff HEAD --name-only
                      OUTPUT_VARIABLE changed OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(changed)
        string(REPLACE "\n" ";" changed "${changed}")
        list(LENGTH changed dirty_files)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" diff HEAD
                        OUTPUT_VARIABLE diff ERROR_QUIET)
        string(SHA256 sum "${diff}")
        string(SUBSTRING "${sum}" 0 8 dirty_hash)
      endif()
    endif()
  endif()
  file(WRITE "${OUT}.tmp"
    "// GENERATED by cmake/BuildInfo.cmake on every build; never edit.\n"
    "#include \"capture/build_info.hpp\"\n"
    "namespace ge::capture {\n"
    "const BuildInfo& build_info() {\n"
    "  static const BuildInfo kInfo{\"${commit}\", \"${branch}\", \"${date}\", ${dirty_files},\n"
    "                               \"${dirty_hash}\", \"${BUILD_TYPE}\", \"${COMPILER}\",\n"
    "                               \"${SYSTEM}\"};\n"
    "  return kInfo;\n"
    "}\n"
    "}  // namespace ge::capture\n")
  file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
  file(REMOVE "${OUT}.tmp")
  return()
endif()

set(GE_BUILD_INFO_CPP "${PROJECT_BINARY_DIR}/gen/build_info/build_info.cpp")
# Runs on every build (a target with no output named is always out of date); the file it writes
# changes only when the stamp does.
add_custom_target(ge_build_info_stamp
  COMMAND ${CMAKE_COMMAND} -DROOT=${PROJECT_SOURCE_DIR} -DOUT=${GE_BUILD_INFO_CPP}
          "-DBUILD_TYPE=$<IF:$<CONFIG:>,${CMAKE_BUILD_TYPE},$<CONFIG>>"
          "-DCOMPILER=${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}"
          "-DSYSTEM=${CMAKE_SYSTEM_NAME} ${CMAKE_SYSTEM_PROCESSOR}"
          -P ${PROJECT_SOURCE_DIR}/cmake/BuildInfo.cmake
  BYPRODUCTS ${GE_BUILD_INFO_CPP}
  COMMENT "Stamping the build"
  VERBATIM)
add_library(ge_build_info STATIC ${GE_BUILD_INFO_CPP})
add_dependencies(ge_build_info ge_build_info_stamp)
target_link_libraries(ge_build_info PUBLIC ge_core)

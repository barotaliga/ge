# The script half of ge_add_cli (cmake/Cli.cmake), run as `cmake -P` at build time: write OUT,
# a C++ file holding every consumer skill (consumer-skills/<name>/SKILL.md), every scaffold file
# (scaffold/**) and the engine's VERSION, as byte arrays behind ge::cli::embedded_files() and
# ge::cli::engine_version() (engine/cli/embedded.hpp). Byte arrays, not string literals: no
# compiler caps their length and no file's text can end one early. Line ends are LF on every
# platform. Inputs: ROOT, OUT.
cmake_minimum_required(VERSION 3.25)

file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${ROOT}"
  "${ROOT}/consumer-skills/*/SKILL.md" "${ROOT}/scaffold/*")
list(SORT files)
file(STRINGS "${ROOT}/VERSION" version LIMIT_COUNT 1)
if(NOT version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
  message(FATAL_ERROR "ge: VERSION reads '${version}', not X.Y.Z. Only the release workflow "
    "writes it: restore it from main; skill: release.")
endif()

set(arrays "")
set(rows "")
set(i 0)
foreach(file IN LISTS files)
  # Every '\r' dropped: a Windows checkout turns LF into CRLF, and ge writes and hashes the same
  # bytes on every platform (read_text drops '\r' too).
  file(READ "${ROOT}/${file}" text)
  string(REPLACE "\r" "" text "${text}")
  file(WRITE "${OUT}.lf" "${text}")
  file(READ "${OUT}.lf" hex HEX)
  string(LENGTH "${hex}" digits)
  math(EXPR size "${digits} / 2")
  # 32 bytes a line keeps the generated file readable in a debugger.
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n    " bytes "${bytes}")
  string(APPEND arrays "const unsigned char k${i}[] = {\n    ${bytes}0};\n")
  string(APPEND rows "    {\"${file}\", {reinterpret_cast<const char*>(k${i}), ${size}}},\n")
  math(EXPR i "${i} + 1")
endforeach()

file(WRITE "${OUT}.tmp" "// GENERATED by cmake/EmbedFiles.cmake from consumer-skills/, scaffold/ and
// VERSION. Do not edit: change those and rebuild.
#include \"cli/embedded.hpp\"

namespace ge::cli {
namespace {

${arrays}
const EmbeddedFile kFiles[] = {
${rows}};

}  // namespace

std::span<const EmbeddedFile> embedded_files() { return kFiles; }

std::string_view engine_version() { return \"${version}\"; }

}  // namespace ge::cli
")
# Only a changed file is rewritten, so an unrelated rebuild does not recompile it.
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp" "${OUT}.lf")

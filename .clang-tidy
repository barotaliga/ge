# Bug-finding checks only; style is clang-format's. EnumCastOutOfRange is off because Dawn's
# flag enums (wgpu::TextureUsage, BufferUsage) are combined with | by design.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  performance-*,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange
WarningsAsErrors: '*'
HeaderFilterRegex: '(engine|games|tests)/.*'
